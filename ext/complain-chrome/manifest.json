{
  "manifest_version": 3,
  "name": "Susanin — в VPN",
  "description": "Жалоба «не открывается сайт» из браузера в Susanin.Keenetic (кнопка панели, та же семантика)",
  "version": "0.1",
  "permissions": ["contextMenus", "notifications", "storage", "activeTab"],
  "host_permissions": ["http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Susanin: в VPN" },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
